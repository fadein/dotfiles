#######################################################################
## MSGTYPE - The format is
#
#   MSGTYPE=foo "string to match"
#
# Where "foo" is one of "hide", "stop" or "norep", and the string to match is a
# message to be matched. Regular expressions are supported.
#
#     "hide" hides the message, so it's never shown.
#     "stop" always prompts for --More-- after the message.
#     "norep" shows the message, but not again if no other message is shown in
#         between.
#     "show" shows the message, each time. This is the default, and probably
#         never needs to be explicitly configured.

# Don't repeat common messages
MSGTYPE=norep "You (descend|climb up) the stairs."
MSGTYPE=norep "You see here a.*"

# Hide unimportant messages
MSGTYPE=hide "You swap places with .*"
MSGTYPE=hide "With great effort you move the boulder."
MSGTYPE=hide "It's solid stone."
MSGTYPE=hide "Your tentacles suck the .*"


